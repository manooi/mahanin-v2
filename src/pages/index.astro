---
import Base from '../layouts/Base.astro';
import Window from '../components/os94/Window.astro';

const title = 'Sirawit Mahanin';
const description = "Sirawit Mahanin — Consultant Developer at Thoughtworks, Bangkok. Resume, photography, and projects.";
const canonical = 'https://mahanin.com/';
const ogTitle = 'Sirawit Mahanin';
const ogDescription = 'Consultant Developer at Thoughtworks, Bangkok. Resume, photography, and projects.';

// Window geometry — single source of truth (design's DEFS table). Never duplicate into JS.
const DEFS = {
  welcome:  { x: 430, y: 80,  w: 450, h: 428 },
  readme:   { x: 236, y: 44,  w: 460, h: 353 },
  // char is parked: no APPS entry, so it has no opener anywhere (icon grid/mobile/start/ctx menu).
  // Still rendered + closed in the DOM; restorable by re-adding a `char` entry to APPS below.
  char:     { x: 392, y: 110, w: 458, h: 452 },
  projects: { x: 352, y: 150, w: 452, h: 356 },
  contact:  { x: 420, y: 138, w: 408, h: 243 },
  winamp:   { x: 520, y: 430, w: 276, h: 168 },
};
// welcome opens above the other 5 (z=25) so it lands on top of readme; runtime topZ starts at 30 so later focuses still win.
// Z values kept identical to the pre-removal numbering for survivors (life/now/guest/computer/photo/resume/books removed); winamp is new, one above the old highest static z. Gaps are harmless.
const Z = { readme: 10, char: 13, projects: 15, contact: 20, winamp: 21, welcome: 25 };

// Apps drive the icon grid, mobile menu, and start menu. An entry with `href` renders
// as a link (no window) instead of a `data-app` opener. External hrefs (http…) get
// target="_blank" + rel="noopener noreferrer"; internal ones stay same-tab.
const linkAttrs = (href) => (href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const APPS = [
  { id: 'welcome',  icon: '👋', gridLines: ['welcome'],           mobileLabel: 'welcome',           startLabel: 'welcome' },
  { id: 'readme',   icon: '📝', gridLines: ['readme.txt'],        mobileLabel: 'readme.txt',        startLabel: 'readme.txt' },
  { id: 'resume',   icon: '👔', gridLines: ['resume', '(for HR)'], mobileLabel: 'resume (for HR)',   startLabel: 'resume (for HR)', href: '/resume/' },
  { id: 'photo',    icon: '📷', gridLines: ['photos'],             mobileLabel: 'photos',            startLabel: 'photos',          href: 'https://unsplash.com/@souperwit' },
  { id: 'projects', icon: '🛠️', gridLines: ['projects'],           mobileLabel: 'projects',          startLabel: 'projects' },
  { id: 'books',    icon: '📚', gridLines: ['bookshelf'],          mobileLabel: 'bookshelf',         startLabel: 'bookshelf',       href: 'https://www.goodreads.com/user/show/177765370-sirawit-mahanin' },
  { id: 'contact',  icon: '✉️', gridLines: ['say hi'],             mobileLabel: 'say hi',            startLabel: 'say hi' },
  { id: 'winamp',   icon: '🎵', gridLines: ['winamp'],             mobileLabel: 'winamp',            startLabel: 'winamp' },
];
const appsById = Object.fromEntries(APPS.map((app) => [app.id, app]));
// Start menu mirrors APPS order; null entries are separators before shutdown.
const START_ORDER = ['welcome', 'readme', 'resume', null, 'photo', 'projects', 'books', 'contact', 'winamp', null];
---
<Base title={title} description={description} canonical={canonical} ogTitle={ogTitle} ogDescription={ogDescription}>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/silkscreen-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin>
  </Fragment>

  <main id="os" class="os-root is-booting">
    <noscript><style>.screen-boot{display:none!important}</style></noscript>

    <div id="wallpaper" class="wallpaper" data-wall="0"></div>

    <div id="desktop" class="desktop">
      <div id="icons" class="icons">
        {APPS.map((app) => (
          app.href
            ? <a class="icon" href={app.href} {...linkAttrs(app.href)}><span class="icon-glyph">{app.icon}</span><span class="icon-label">{app.gridLines.length > 1 ? <Fragment>{app.gridLines[0]}<br />{app.gridLines[1]}</Fragment> : app.gridLines[0]}</span></a>
            : <button type="button" class="icon" data-app={app.id}><span class="icon-glyph">{app.icon}</span><span class="icon-label">{app.gridLines.length > 1 ? <Fragment>{app.gridLines[0]}<br />{app.gridLines[1]}</Fragment> : app.gridLines[0]}</span></button>
        ))}
      </div>

      <div class="mobile-menu">
        <div class="mobile-menu-head">
          <div class="mobile-menu-title">SIRAWIT MAHANIN</div>
          <div class="mobile-menu-sub">DEVELOPER · BANGKOK · EST. 1994</div>
        </div>
        <div class="mobile-menu-rows">
          {APPS.filter((app) => app.mobileLabel).map((app) => (
            app.href
              ? <a class="m-row" href={app.href} {...linkAttrs(app.href)}><span class="m-row-icon">{app.icon}</span><span class="m-row-label">{app.mobileLabel}</span><span class="m-row-arrow">▶</span></a>
              : <button type="button" class="m-row" data-app={app.id}><span class="m-row-icon">{app.icon}</span><span class="m-row-label">{app.mobileLabel}</span><span class="m-row-arrow">▶</span></button>
          ))}
        </div>
      </div>

      <div class="widgets">
        <div class="sticky-note">
          <div class="sticky-note-label">STICKY NOTE</div>
          currently open to work &mdash; and to good coffee recommendations.
          <div class="sticky-note-sign">— me, to me</div>
        </div>

        <div class="sysmon">
          <div class="sysmon-label">SYSTEM MONITOR</div>
          <div class="sysmon-body">HOST · SIRAWIT MAHANIN<br>LOC &nbsp;· BANGKOK, TH 🇹🇭<br>BUILD · 1994<br>MEM &nbsp;· MOSTLY FINE</div>
          <div class="sysmon-meter"><div class="sysmon-meter-fill"></div></div>
          <div class="sysmon-caption">CAFFEINE 82%</div>
        </div>
      </div>

      <Window id="welcome" title="👋 welcome.exe" x={DEFS.welcome.x} y={DEFS.welcome.y} w={DEFS.welcome.w} h={DEFS.welcome.h} z={Z.welcome} open bodyClass="win-body--pad-lg">
        <div class="sec-label">FIRST TIME HERE?</div>
        <p>Quick menu.</p>
        <a href="/resume/" class="row welcome-primary">👔 <span class="row-label">open the resume</span><span class="row-badge">FOR HR &mdash; PRINTABLE PDF</span></a>
        <div class="contact-rows">
          <button type="button" class="row" data-app="readme">📝 <span class="row-label">who is this guy?</span></button>
          <a href="https://unsplash.com/@souperwit" target="_blank" rel="noopener noreferrer" class="row">📷 <span class="row-label">photos</span></a>
          <button type="button" class="row" data-app="projects">🛠️ <span class="row-label">projects</span></button>
          <button type="button" class="row" data-app="contact">✉️ <span class="row-label">say hi</span></button>
        </div>
        <noscript><p class="noscript-links"><a href="/resume/">Resume</a> · <a href="https://unsplash.com/@souperwit">Unsplash</a> · <a href="https://github.com/manooi">GitHub</a> · <a href="https://www.goodreads.com/user/show/177765370-sirawit-mahanin">Goodreads</a> · <a href="mailto:sirawit@mahanin.com">Email</a> · <a href="https://www.linkedin.com/in/sirawit-wit-mahanin-b3a42614a/">LinkedIn</a></p></noscript>
        <label class="welcome-startup"><input type="checkbox" id="welcome-startup" checked> show this window at startup</label>
      </Window>

      <Window id="readme" title="📝 readme.txt" x={DEFS.readme.x} y={DEFS.readme.y} w={DEFS.readme.w} h={DEFS.readme.h} z={Z.readme} bodyClass="win-body--pad-lg">
        <h1 class="readme-title">HELLO, VISITOR</h1>
        <div class="readme-subtitle">SIRAWIT &ldquo;WIT&rdquo; MAHANIN · EST. 1994</div>
        <p>Consultant Developer at Thoughtworks, Bangkok. Ex&#8209;civil engineer: I used to design things that must not fall down, now I ship things that occasionally do.</p>
        <p>I take pictures and read books. This is my desktop &mdash; poke around, nothing here can break. I already tried.</p>
        <p>Why mahanin.com? I wanted sirawit.com, but it was taken. And no, I&rsquo;m not the only Mahanin.</p>
        <div class="card readme-tip">
          <span class="tip-arrow">&gt;</span> tip: the <strong>resume</strong> folder is the polite one.<br>
          <span class="tip-arrow">&gt;</span> everything else is the real me.<span class="blink-cursor">_</span>
        </div>
      </Window>

      <Window id="char" title="🍁 character.dat" x={DEFS.char.x} y={DEFS.char.y} w={DEFS.char.w} h={DEFS.char.h} z={Z.char} variant="char">
        <div class="char-top">
          <div class="char-sprite">character<br>sprite</div>
          <div class="char-info">
            <div class="char-ign">[ IGN HERE ]</div>
            <div class="char-meta">LV. 32 · [ CLASS ] · [ WORLD ]</div>
            <div class="char-exp-label">EXP TO NEXT BIRTHDAY</div>
            <div class="char-exp-track"><div class="char-exp-fill"></div></div>
            <div class="char-exp-pct">62.00%</div>
          </div>
        </div>
        <div class="char-stats">
          <div class="card stat-box">HP <span class="char-stat-hp">2,140 / 2,140</span></div>
          <div class="card stat-box">MP <span class="char-stat-mp">980 / 3,000</span></div>
          <div class="card stat-box">STR <span class="char-stat-muted">deadlines</span></div>
          <div class="card stat-box">DEX <span class="char-stat-muted">camera</span></div>
          <div class="card stat-box">INT <span class="char-stat-muted">books</span></div>
          <div class="card stat-box">LUK <span class="char-stat-muted">unverified</span></div>
        </div>
        <div class="card char-equip">
          <div class="char-equip-label">EQUIPPED</div>
          keyboard · one prime lens · library card · a mug that says nothing funny
        </div>
        <p class="char-note">Tell me your real IGN, class and world and I&rsquo;ll put them in.</p>
      </Window>

      <Window id="projects" title="🛠️ projects" x={DEFS.projects.x} y={DEFS.projects.y} w={DEFS.projects.w} h={DEFS.projects.h} z={Z.projects}>
        <p>Half of these are finished. The other half taught me something, which is basically the same thing.</p>
        <div class="project-list">
          <div class="project-row"><span class="project-num">01</span><span class="project-desc">this website &mdash; <span class="project-desc-sub">a desktop that lives in a browser</span></span></div>
          <div class="project-row"><span class="project-num">02</span><span class="project-desc">[ project name ] &mdash; <span class="project-desc-sub">one line about it</span></span></div>
          <div class="project-row"><span class="project-num">03</span><span class="project-desc">[ project name ] &mdash; <span class="project-desc-sub">one line about it</span></span></div>
        </div>
        <a href="https://github.com/manooi" class="btn-9x">GITHUB @manooi →</a>
      </Window>

      <Window id="contact" title="✉️ say hi" x={DEFS.contact.x} y={DEFS.contact.y} w={DEFS.contact.w} h={DEFS.contact.h} z={Z.contact}>
        <p>Work, photos, book recommendations. All welcome.</p>
        <div class="contact-rows">
          <a href="mailto:sirawit@mahanin.com" class="row">📧 <span class="row-label">email me</span></a>
          <a href="https://www.linkedin.com/in/sirawit-wit-mahanin-b3a42614a/" class="row">💼 <span class="row-label">LinkedIn</span></a>
          <a href="https://github.com/manooi" class="row">🛠️ <span class="row-label">GitHub</span></a>
        </div>
      </Window>

      <Window id="winamp" title="🎵 winamp" x={DEFS.winamp.x} y={DEFS.winamp.y} w={DEFS.winamp.w} h={DEFS.winamp.h} z={Z.winamp} bodyClass="win-body--flush">
        <div class="winamp-head">
          <span class="winamp-head-label">NOW PLAYING</span>
          <span class="winamp-head-kbps">KBPS 128</span>
        </div>
        <div class="winamp-body">
          <div class="winamp-track"><span class="winamp-track-text">[ your track here ] — [ artist ] &nbsp;·&nbsp; [ something on repeat ] &nbsp;·&nbsp; [ your track here ] — [ artist ] &nbsp;·&nbsp; [ something on repeat ] &nbsp;·&nbsp; </span></div>
          <div class="winamp-eq">
            <span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span>
          </div>
          <div class="winamp-transport">
            <span class="winamp-btn">◀◀</span>
            <span class="winamp-btn winamp-btn--accent">▶</span>
            <span class="winamp-btn">❚❚</span>
            <span class="winamp-btn">▶▶</span>
          </div>
        </div>
      </Window>

      <div id="ctx-menu" class="ctx-menu" data-menu="ctx">
        <button type="button" class="menu-item" data-action="wall">change wallpaper</button>
        <div class="menu-sep"></div>
        <button type="button" class="menu-item" data-app="readme">about this desktop</button>
      </div>
    </div>

    <div id="start-menu" class="start-menu" data-menu="start">
      <div class="start-spine"><span class="start-spine-label">MAHANIN 94</span></div>
      <div class="start-items">
        {START_ORDER.map((id) => (
          id === null
            ? <div class="menu-sep"></div>
            : appsById[id].href
              ? <a class="start-item" href={appsById[id].href} {...linkAttrs(appsById[id].href)}><span class="start-item-icon">{appsById[id].icon}</span>{appsById[id].startLabel}</a>
              : <button type="button" class="start-item" data-app={id}><span class="start-item-icon">{appsById[id].icon}</span>{appsById[id].startLabel}</button>
        ))}
        <button type="button" class="start-item start-item--danger" data-action="shutdown"><span class="start-item-icon">⏻</span>shut down...</button>
      </div>
    </div>

    <div class="taskbar">
      <button type="button" class="start-btn" data-action="start" data-menu="start">
        <span class="start-btn-logo"></span>
        <span class="start-btn-label">MAHANIN</span>
      </button>
      <div class="tb-sep"></div>
      <div id="taskbar-btns" class="taskbar-btns">
        <button type="button" class="task-btn" data-task="welcome">👋 welcome.exe</button>
      </div>
      <div class="tray">
        <span id="uptime">UPTIME —</span>
        <span class="tray-divider"></span>
        <span id="clock">--:-- --</span>
      </div>
    </div>

    <div class="screen-off">
      <div class="off-inner">
        <div class="off-title">IT&rsquo;S NOW SAFE TO CLOSE<br>THIS TAB.</div>
        <div class="off-sub">thanks for visiting. seriously.</div>
        <button type="button" class="btn-9x btn-9x--power" data-action="poweron">⏻ TURN IT BACK ON</button>
      </div>
    </div>

    <div class="screen-boot">
      <div class="boot-inner">
        <div class="boot-title">MAHANIN OS 94</div>
        <div id="boot-lines"></div>
        <div class="boot-skip">press anything to skip<span class="blink-cursor">▌</span></div>
      </div>
    </div>

    <script src="../scripts/os94.js"></script>
  </main>
</Base>

<style is:global>
  @font-face {
    font-family: 'Silkscreen';
    src: url('/fonts/silkscreen-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/ibm-plex-mono-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/ibm-plex-mono-600.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #0e5750; }
  a { color: #8a3b12; text-decoration: underline; text-underline-offset: 2px; }
  a:hover { color: #c2477d; }

  @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes marq { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  @keyframes eq { 0%, 100% { height: 20%; } 50% { height: 100%; } }
  .blink-cursor { animation: blink 1.1s steps(1) infinite; }

  /* ---------- root / wallpaper / desktop ---------- */
  .os-root {
    position: fixed;
    inset: 0;
    background: #0e5750;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    overflow: hidden;
  }
  .wallpaper { position: absolute; inset: 0; }
  .wallpaper[data-wall="0"] { background: #0e5750; background-image: radial-gradient(rgba(255,255,255,.055) 1px,transparent 1px); background-size: 4px 4px; }
  .wallpaper[data-wall="1"] { background: #2b2450; background-image: linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px); background-size: 26px 26px; }
  .wallpaper[data-wall="2"] { background: #7a3a2e; background-image: repeating-linear-gradient(180deg,rgba(255,220,150,.13) 0 12px,transparent 12px 40px); }
  .wallpaper[data-wall="3"] { background: #7c8f4a; background-image: repeating-linear-gradient(90deg,rgba(0,0,0,.08) 0 3px,transparent 3px 6px); }

  .desktop { position: absolute; top: 0; left: 0; right: 0; bottom: 44px; overflow: hidden; }

  /* ---------- icons ---------- */
  .icons { display: grid; position: absolute; top: 18px; left: 18px; grid-template-columns: repeat(1,88px); gap: 4px 6px; z-index: 2; }
  .icon {
    display: flex; flex-direction: column; align-items: center; gap: 5px;
    padding: 8px 4px 6px; cursor: pointer; border: 1px dotted transparent; border-radius: 2px;
    background: transparent; font: inherit; color: inherit; text-decoration: none;
  }
  .icon:hover { background: rgba(255,255,255,.14); border: 1px dotted rgba(255,255,255,.55); }
  .icon-glyph { font-size: 29px; line-height: 1; filter: drop-shadow(2px 2px 0 rgba(0,0,0,.35)); }
  .icon-label { font: 400 9.5px/1.35 Silkscreen,monospace; color: #fff; text-align: center; text-shadow: 1px 1px 0 rgba(0,0,0,.5); }

  /* ---------- mobile menu ---------- */
  .mobile-menu { display: none; position: absolute; inset: 0; overflow: auto; background: rgba(6,30,28,.55); z-index: 2; }
  .mobile-menu-head { padding: 14px 16px 10px; background: #3a3450; border-bottom: 2px solid #1a1626; }
  .mobile-menu-title { font: 400 15px/1.3 Silkscreen,monospace; color: #fff; }
  .mobile-menu-sub { font: 400 9px/1.5 Silkscreen,monospace; color: #b9aee8; margin-top: 5px; }
  .mobile-menu-rows { padding: 10px; display: flex; flex-direction: column; gap: 6px; }
  .m-row {
    display: flex; gap: 11px; align-items: center; width: 100%; text-align: left;
    background: #d8d2c4; border: 2px solid; border-color: #fffdf7 #4a453c #4a453c #fffdf7;
    padding: 11px 12px; cursor: pointer; font: inherit; color: inherit; text-decoration: none;
  }
  .m-row-icon { font-size: 19px; }
  .m-row-label { flex: 1; font: 400 10px Silkscreen,monospace; color: #2a2620; }
  .m-row-arrow { color: #8a3b12; }

  /* ---------- desktop widgets ---------- */
  .widgets { position: absolute; inset: 0; z-index: 1; }
  .sticky-note {
    position: absolute; right: 26px; bottom: 330px; width: 180px; padding: 13px 14px 15px;
    background: #f2e27a; box-shadow: 3px 3px 0 rgba(0,0,0,.28); transform: rotate(-2.2deg);
    font: 400 12px/1.55 'IBM Plex Mono',monospace; color: #4a3d05;
  }
  .sticky-note-label { font: 400 10px/1.4 Silkscreen,monospace; color: #8a6f0e; margin-bottom: 7px; }
  .sticky-note-sign { margin-top: 8px; font-size: 10.5px; color: #8a6f0e; }

  .winamp-head { display: flex; align-items: center; gap: 6px; padding: 4px 6px; background: linear-gradient(90deg,#14101f,#3a3450); }
  .winamp-head-label { font: 400 8.5px Silkscreen,monospace; color: #8fe3d6; flex: 1; }
  .winamp-head-kbps { font: 400 8.5px Silkscreen,monospace; color: #f2c14b; }
  .winamp-body { padding: 9px 10px 11px; }
  .winamp-track { background: #14101f; border: 1px solid #6b619b; padding: 5px 6px; overflow: hidden; white-space: nowrap; }
  .winamp-track-text { display: inline-block; font: 400 9.5px Silkscreen,monospace; color: #8fe3d6; animation: marq 11s linear infinite; }
  .winamp-eq { display: flex; align-items: flex-end; gap: 2px; height: 22px; margin: 8px 0 7px; }
  .eq-bar { flex: 1; background: #8fe3d6; }
  .eq-bar:nth-child(1) { animation: eq .9s ease-in-out infinite; height: 40%; }
  .eq-bar:nth-child(2) { animation: eq .7s ease-in-out .1s infinite; height: 70%; }
  .eq-bar:nth-child(3) { background: #f2c14b; animation: eq 1.1s ease-in-out .2s infinite; height: 30%; }
  .eq-bar:nth-child(4) { animation: eq .8s ease-in-out .05s infinite; height: 90%; }
  .eq-bar:nth-child(5) { animation: eq 1s ease-in-out .3s infinite; height: 50%; }
  .eq-bar:nth-child(6) { background: #e07a3f; animation: eq .75s ease-in-out .15s infinite; height: 65%; }
  .eq-bar:nth-child(7) { animation: eq .95s ease-in-out .25s infinite; height: 35%; }
  .eq-bar:nth-child(8) { animation: eq .85s ease-in-out .4s infinite; height: 80%; }
  .winamp-transport { display: flex; gap: 4px; }
  .winamp-btn {
    flex: 1; text-align: center; background: #4a4370; border: 1px solid; border-color: #8177b5 #14101f #14101f #8177b5;
    padding: 3px 0; font: 400 9px Silkscreen,monospace; color: #dcd6f5;
  }
  .winamp-btn--accent { color: #f2c14b; }

  .sysmon { position: absolute; right: 20px; bottom: 16px; width: 196px; padding: 10px 12px 12px; background: rgba(6,42,38,.6); border: 1px solid rgba(255,255,255,.22); }
  .sysmon-label { font: 400 9px/1.4 Silkscreen,monospace; color: #8fe3d6; letter-spacing: .5px; margin-bottom: 7px; }
  .sysmon-body { font: 400 10.5px/1.8 'IBM Plex Mono',monospace; color: #dff5f0; }
  .sysmon-meter { margin-top: 8px; height: 8px; background: #06322d; border: 1px solid rgba(255,255,255,.2); }
  .sysmon-meter-fill { height: 100%; width: 82%; background: repeating-linear-gradient(90deg,#e07a3f 0 5px,#06322d 5px 7px); }
  .sysmon-caption { font: 400 8.5px/1.4 Silkscreen,monospace; color: #8fe3d6; margin-top: 5px; }

  /* ---------- window chrome (Window.astro) ---------- */
