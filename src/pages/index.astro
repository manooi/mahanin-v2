---
import Base from '../layouts/Base.astro';
import Window from '../components/os94/Window.astro';

const title = 'Sirawit Mahanin';
const description = "Sirawit Mahanin — Consultant Developer at Thoughtworks, Bangkok. Resume, photography, and projects.";
const canonical = 'https://mahanin.com/';
const ogTitle = 'Sirawit Mahanin';
const ogDescription = 'Consultant Developer at Thoughtworks, Bangkok. Resume, photography, and projects.';

// Window geometry — single source of truth (design's DEFS table). Never duplicate into JS.
const DEFS = {
  readme:   { x: 236, y: 44,  w: 430, h: 372 },
  resume:   { x: 316, y: 118, w: 452, h: 424 },
  computer: { x: 352, y: 84,  w: 420, h: 400 },
  char:     { x: 392, y: 110, w: 458, h: 452 },
  photo:    { x: 400, y: 92,  w: 424, h: 466 },
  projects: { x: 352, y: 150, w: 452, h: 356 },
  books:    { x: 288, y: 96,  w: 424, h: 420 },
  life:     { x: 380, y: 128, w: 400, h: 372 },
  now:      { x: 344, y: 172, w: 440, h: 320 },
  guest:    { x: 296, y: 106, w: 424, h: 428 },
  contact:  { x: 420, y: 138, w: 408, h: 348 },
};
const Z = Object.fromEntries(Object.keys(DEFS).map((k, i) => [k, 10 + i]));

// Apps drive the icon grid, mobile menu, and start menu.
const APPS = [
  { id: 'readme',   icon: '📝', gridLines: ['readme.txt'],        mobileLabel: 'readme.txt',        startLabel: 'readme.txt' },
  { id: 'resume',   icon: '👔', gridLines: ['resume', '(for HR)'], mobileLabel: 'resume (for HR)',   startLabel: 'resume (for HR)' },
  { id: 'computer', icon: '💾', gridLines: ['my', 'computer'],     mobileLabel: null,                startLabel: 'my computer' },
  { id: 'char',     icon: '🍁', gridLines: ['character'],          mobileLabel: 'character',         startLabel: 'character' },
  { id: 'photo',    icon: '📷', gridLines: ['photos'],             mobileLabel: 'photos',            startLabel: 'photos' },
  { id: 'projects', icon: '🛠️', gridLines: ['projects'],           mobileLabel: 'projects',          startLabel: 'projects' },
  { id: 'books',    icon: '📚', gridLines: ['bookshelf'],          mobileLabel: 'bookshelf',         startLabel: 'bookshelf' },
  { id: 'life',     icon: '🏠', gridLines: ['life.exe'],           mobileLabel: 'life.exe',          startLabel: null },
  { id: 'now',      icon: '🕹️', gridLines: ['now'],                mobileLabel: 'now',               startLabel: 'now' },
  { id: 'guest',    icon: '✍️', gridLines: ['guestbook'],          mobileLabel: 'guestbook',         startLabel: 'guestbook' },
  { id: 'contact',  icon: '✉️', gridLines: ['say hi'],             mobileLabel: 'say hi',            startLabel: 'say hi' },
];
const appsById = Object.fromEntries(APPS.map((app) => [app.id, app]));
// Start menu order/inclusion differs from icon grid: char before computer, life omitted entirely.
const START_ORDER = ['readme', 'resume', 'char', 'computer', null, 'photo', 'projects', 'books', 'now', 'guest', 'contact', null];
---
<Base title={title} description={description} canonical={canonical} ogTitle={ogTitle} ogDescription={ogDescription}>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/silkscreen-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin>
  </Fragment>

  <main id="os" class="os-root is-booting">
    <noscript><style>.screen-boot{display:none!important}</style></noscript>

    <div id="wallpaper" class="wallpaper" data-wall="0"></div>

    <div id="desktop" class="desktop">
      <div id="icons" class="icons">
        {APPS.map((app) => (
          <button type="button" class="icon" data-app={app.id}>
            <span class="icon-glyph">{app.icon}</span>
            <span class="icon-label">{app.gridLines.length > 1 ? <Fragment>{app.gridLines[0]}<br />{app.gridLines[1]}</Fragment> : app.gridLines[0]}</span>
          </button>
        ))}
      </div>

      <div class="mobile-menu">
        <div class="mobile-menu-head">
          <div class="mobile-menu-title">SIRAWIT MAHANIN</div>
          <div class="mobile-menu-sub">DEVELOPER · BANGKOK · EST. 1994</div>
        </div>
        <div class="mobile-menu-rows">
          {APPS.filter((app) => app.mobileLabel).map((app) => (
            <button type="button" class="m-row" data-app={app.id}>
              <span class="m-row-icon">{app.icon}</span>
              <span class="m-row-label">{app.mobileLabel}</span>
              <span class="m-row-arrow">▶</span>
            </button>
          ))}
        </div>
      </div>

      <div class="widgets">
        <div class="sticky-note">
          <div class="sticky-note-label">STICKY NOTE</div>
          currently open to work &mdash; and to good coffee recommendations.
          <div class="sticky-note-sign">— me, to me</div>
        </div>

        <div class="winamp">
          <div class="winamp-head">
            <span class="winamp-head-label">NOW PLAYING</span>
            <span class="winamp-head-kbps">KBPS 128</span>
          </div>
          <div class="winamp-body">
            <div class="winamp-track"><span class="winamp-track-text">[ your track here ] — [ artist ] &nbsp;·&nbsp; henesys field theme &nbsp;·&nbsp; [ your track here ] — [ artist ] &nbsp;·&nbsp; henesys field theme &nbsp;·&nbsp; </span></div>
            <div class="winamp-eq">
              <span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span>
            </div>
            <div class="winamp-transport">
              <span class="winamp-btn">◀◀</span>
              <span class="winamp-btn winamp-btn--accent">▶</span>
              <span class="winamp-btn">❚❚</span>
              <span class="winamp-btn">▶▶</span>
            </div>
          </div>
        </div>

        <div class="sysmon">
          <div class="sysmon-label">SYSTEM MONITOR</div>
          <div class="sysmon-body">HOST · SIRAWIT MAHANIN<br>LOC &nbsp;· BANGKOK, TH 🇹🇭<br>BUILD · 1994<br>MEM &nbsp;· MOSTLY FINE</div>
          <div class="sysmon-meter"><div class="sysmon-meter-fill"></div></div>
          <div class="sysmon-caption">CAFFEINE 82%</div>
        </div>
      </div>

      <Window id="readme" title="📝 readme.txt" x={DEFS.readme.x} y={DEFS.readme.y} w={DEFS.readme.w} h={DEFS.readme.h} z={Z.readme} open bodyClass="win-body--pad-lg">
        <h1 class="readme-title">HELLO, VISITOR</h1>
        <div class="readme-subtitle">SIRAWIT &ldquo;WIT&rdquo; MAHANIN · EST. 1994</div>
        <p>Consultant Developer at Thoughtworks, Bangkok. Ex&#8209;civil engineer: I used to design things that must not fall down, now I ship things that occasionally do.</p>
        <p>I take pictures, read books, and keep a MapleStory character alive out of loyalty. This is my desktop. Poke around &mdash; drag windows, right&#8209;click the wallpaper, nothing here can break. I already tried.</p>
        <p>Why mahanin.com? I wanted sirawit.com, but it was taken. And no, I&rsquo;m not the only Mahanin.</p>
        <div class="card readme-tip">
          <span class="tip-arrow">&gt;</span> tip: the <strong>resume</strong> folder is the polite one.<br>
          <span class="tip-arrow">&gt;</span> everything else is the real me.<span class="blink-cursor">_</span>
        </div>
        <noscript><p class="noscript-links"><a href="/resume/">Resume</a> · <a href="https://unsplash.com/@manooi">Unsplash</a> · <a href="https://github.com/manooi">GitHub</a> · <a href="mailto:sirawit@mahanin.com">Email</a> · <a href="https://www.linkedin.com/in/sirawit-wit-mahanin-b3a42614a/">LinkedIn</a></p></noscript>
      </Window>

      <Window id="resume" title="👔 resume.doc" x={DEFS.resume.x} y={DEFS.resume.y} w={DEFS.resume.w} h={DEFS.resume.h} z={Z.resume} bodyClass="win-body--pad-lg">
        <div class="hr-badge">FOR HR EYES ONLY 👔</div>
        <p>This is the serious one. Proper job titles, real dates, zero MapleStory references (one). Printable straight to PDF, Comic&nbsp;Sans free, guaranteed.</p>
        <div class="card resume-info">
          ROLE &nbsp;· Consultant Developer, Thoughtworks<br>
          BEFORE · Civil engineer (buildings, briefly)<br>
          BASED &nbsp;· Bangkok, Thailand<br>
          STATUS · Open to a good conversation
        </div>
        <a href="/resume/" class="btn-9x">OPEN FULL RESUME →</a>
      </Window>

      <Window id="computer" title="💾 my computer" x={DEFS.computer.x} y={DEFS.computer.y} w={DEFS.computer.w} h={DEFS.computer.h} z={Z.computer}>
        <div class="drive-list">
          <button type="button" class="row" data-app="projects"><span class="row-icon">🗄️</span><span class="row-body"><strong>C:\ work</strong><br><span class="row-desc">code, clients, standups. 91% full</span></span></button>
          <button type="button" class="row" data-app="photo"><span class="row-icon">💽</span><span class="row-body"><strong>D:\ hobbies</strong><br><span class="row-desc">photos, books, maple. always room for more</span></span></button>
          <button type="button" class="row" data-app="life"><span class="row-icon">📼</span><span class="row-body"><strong>E:\ regrets</strong><br><span class="row-desc">read&#8209;only. do not defragment</span></span></button>
          <div class="row row--disabled"><span class="row-icon row-icon--muted">💿</span><span class="row-body"><strong>A:\ floppy</strong><br><span class="row-desc">please insert disk 2 of 14</span></span></div>
        </div>
        <div class="computer-note">4 OBJECTS · 1 EMOTIONALLY LOAD&#8209;BEARING</div>
      </Window>

      <Window id="char" title="🍁 character.dat" x={DEFS.char.x} y={DEFS.char.y} w={DEFS.char.w} h={DEFS.char.h} z={Z.char} variant="char">
        <div class="char-top">
          <div class="char-sprite">character<br>sprite</div>
          <div class="char-info">
            <div class="char-ign">[ IGN HERE ]</div>
            <div class="char-meta">LV. 32 · [ CLASS ] · [ WORLD ]</div>
            <div class="char-exp-label">EXP TO NEXT BIRTHDAY</div>
            <div class="char-exp-track"><div class="char-exp-fill"></div></div>
            <div class="char-exp-pct">62.00%</div>
          </div>
        </div>
        <div class="char-stats">
          <div class="card stat-box">HP <span class="char-stat-hp">2,140 / 2,140</span></div>
          <div class="card stat-box">MP <span class="char-stat-mp">980 / 3,000</span></div>
          <div class="card stat-box">STR <span class="char-stat-muted">deadlines</span></div>
          <div class="card stat-box">DEX <span class="char-stat-muted">camera</span></div>
          <div class="card stat-box">INT <span class="char-stat-muted">books</span></div>
          <div class="card stat-box">LUK <span class="char-stat-muted">unverified</span></div>
        </div>
        <div class="card char-equip">
          <div class="char-equip-label">EQUIPPED</div>
          keyboard · one prime lens · library card · a mug that says nothing funny
        </div>
        <p class="char-note">Tell me your real IGN, class and world and I&rsquo;ll put them in.</p>
      </Window>

      <Window id="photo" title="📷 my pictures" x={DEFS.photo.x} y={DEFS.photo.y} w={DEFS.photo.w} h={DEFS.photo.h} z={Z.photo}>
        <p>I point a camera at Bangkok until something looks nice. The good ones live on Unsplash and get used in places I will never visit.</p>
        <div class="photo-grid">
          <div class="photo-tile">street<br>photo</div>
          <div class="photo-tile">neon<br>night</div>
          <div class="photo-tile">portrait</div>
          <div class="photo-tile">temple</div>
          <div class="photo-tile">food,<br>obviously</div>
          <div class="photo-tile">one blurry<br>cat</div>
        </div>
        <a href="https://unsplash.com/@manooi" class="btn-9x">UNSPLASH @manooi →</a>
      </Window>

      <Window id="projects" title="🛠️ projects" x={DEFS.projects.x} y={DEFS.projects.y} w={DEFS.projects.w} h={DEFS.projects.h} z={Z.projects}>
        <p>Half of these are finished. The other half taught me something, which is basically the same thing.</p>
        <div class="project-list">
          <div class="project-row"><span class="project-num">01</span><span class="project-desc">this website &mdash; <span class="project-desc-sub">a desktop that lives in a browser</span></span></div>
          <div class="project-row"><span class="project-num">02</span><span class="project-desc">[ project name ] &mdash; <span class="project-desc-sub">one line about it</span></span></div>
          <div class="project-row"><span class="project-num">03</span><span class="project-desc">[ project name ] &mdash; <span class="project-desc-sub">one line about it</span></span></div>
        </div>
        <a href="https://github.com/manooi" class="btn-9x">GITHUB @manooi →</a>
      </Window>

      <Window id="books" title="📚 bookshelf" x={DEFS.books.x} y={DEFS.books.y} w={DEFS.books.w} h={DEFS.books.h} z={Z.books}>
        <div class="sec-label">NOW READING</div>
        <div class="card book-now">
          <div class="book-now-spine"></div>
          <div class="book-now-info"><strong>[ book title ]</strong><br><span class="book-now-meta">page 47 of 380 · going strong, allegedly</span></div>
        </div>
        <div class="sec-label">SHELVES</div>
        <div class="book-shelves">
          <div class="book-shelf-row"><span>finished, loved it</span><span class="book-shelf-count">00</span></div>
          <div class="book-shelf-row"><span>finished, no comment</span><span class="book-shelf-count">00</span></div>
          <div class="book-shelf-row"><span>abandoned at page 40</span><span class="book-shelf-count">00</span></div>
          <div class="book-shelf-row"><span>bought, still shrink&#8209;wrapped</span><span class="book-shelf-count">00</span></div>
        </div>
        <p class="book-note">Send me the counts and titles and I&rsquo;ll fill this shelf properly.</p>
      </Window>

      <Window id="life" title="🏠 life.exe" x={DEFS.life.x} y={DEFS.life.y} w={DEFS.life.w} h={DEFS.life.h} z={Z.life} bodyClass="win-body--center">
        <div class="under-construction">
          <div class="uc-title">🚧 UNDER CONSTRUCTION 🚧</div>
          <div class="uc-sub">SINCE APPROXIMATELY FOREVER</div>
        </div>
        <p class="life-para">This is where the personal stuff goes: weekend notes, half&#8209;formed opinions, photos of food I already ate.</p>
        <div class="card life-card">
          POSTS &nbsp;· 0<br>
          DRAFTS · a suspicious number<br>
          AMBITION · 100%
        </div>
      </Window>

      <Window id="now" title="🕹️ now.log" x={DEFS.now.x} y={DEFS.now.y} w={DEFS.now.w} h={DEFS.now.h} z={Z.now} variant="term">
        <div class="now-prompt">C:\NOW&gt; type now.log</div>
        <div>[WORK] &nbsp;consulting, shipping, unblocking people</div>
        <div>[PLAY] &nbsp;grinding in MapleStory. level: classified</div>
        <div>[READ] &nbsp;one book, slowly, on purpose</div>
        <div>[SHOOT] walking Bangkok with one lens</div>
        <div>[LEARN] [ whatever you&rsquo;re into right now ]</div>
        <div class="now-updated">— updated whenever life updates<span class="blink-cursor">▌</span></div>
      </Window>

      <Window id="guest" title="✍️ guestbook" x={DEFS.guest.x} y={DEFS.guest.y} w={DEFS.guest.w} h={DEFS.guest.h} z={Z.guest}>
        <p class="guest-intro">Sign the book like it&rsquo;s 2003. No account, no algorithm.</p>
        <div class="guest-form">
          <input id="guest-input" class="guest-input" placeholder="say something nice...">
          <button type="button" class="btn-9x btn-9x--sign" data-action="sign">SIGN</button>
        </div>
        <div id="guest-list">
          <div class="card guest-entry">
            <div class="guest-entry-meta">anonymous · AUG 2026</div>
            <div class="guest-entry-text">found this while procrastinating. worth it.</div>
          </div>
          <div class="card guest-entry">
            <div class="guest-entry-meta">mom · JUL 2026</div>
            <div class="guest-entry-text">call me back please</div>
          </div>
          <div class="card guest-entry">
            <div class="guest-entry-meta">a recruiter · JUL 2026</div>
            <div class="guest-entry-text">i clicked the HR folder. respect.</div>
          </div>
        </div>
        <div class="guest-visitor-line">VISITOR NO. <span id="guest-visitor">OO1997</span></div>
      </Window>

      <Window id="contact" title="✉️ say hi" x={DEFS.contact.x} y={DEFS.contact.y} w={DEFS.contact.w} h={DEFS.contact.h} z={Z.contact}>
        <p>Work, photos, book recommendations, or which class to main next. All welcome.</p>
        <div class="contact-rows">
          <a href="mailto:sirawit@mahanin.com" class="row">📧 <span class="row-label">email me</span><span class="row-badge">FASTEST</span></a>
          <a href="https://www.linkedin.com/in/sirawit-wit-mahanin-b3a42614a/" class="row">💼 <span class="row-label">LinkedIn</span><span class="row-badge">POLITE</span></a>
          <a href="https://github.com/manooi" class="row">🛠️ <span class="row-label">GitHub</span><span class="row-badge">HONEST</span></a>
        </div>
        <p class="contact-note">Replies usually within a day, unless MapleStory has an event.</p>
      </Window>

      <div id="ctx-menu" class="ctx-menu" data-menu="ctx">
        <button type="button" class="menu-item" data-action="wall">change wallpaper</button>
        <button type="button" class="menu-item" data-action="arrange">arrange icons</button>
        <div class="menu-sep"></div>
        <button type="button" class="menu-item" data-app="char">character info</button>
        <button type="button" class="menu-item" data-app="readme">about this desktop</button>
      </div>
    </div>

    <div id="start-menu" class="start-menu" data-menu="start">
      <div class="start-spine"><span class="start-spine-label">MAHANIN 94</span></div>
      <div class="start-items">
        {START_ORDER.map((id) => (
          id === null
            ? <div class="menu-sep"></div>
            : <button type="button" class="start-item" data-app={id}><span class="start-item-icon">{appsById[id].icon}</span>{appsById[id].startLabel}</button>
        ))}
        <button type="button" class="start-item start-item--danger" data-action="shutdown"><span class="start-item-icon">⏻</span>shut down...</button>
      </div>
    </div>

    <div class="taskbar">
      <button type="button" class="start-btn" data-action="start" data-menu="start">
        <span class="start-btn-logo"></span>
        <span class="start-btn-label">MAHANIN</span>
      </button>
      <div class="tb-sep"></div>
      <div id="taskbar-btns" class="taskbar-btns">
        <button type="button" class="task-btn" data-task="readme">📝 readme.txt</button>
      </div>
      <div class="tray">
        <span id="uptime">UPTIME —</span>
        <span class="tray-divider"></span>
        <span id="clock">--:-- --</span>
      </div>
    </div>

    <div class="screen-off">
      <div class="off-inner">
        <div class="off-title">IT&rsquo;S NOW SAFE TO CLOSE<br>THIS TAB.</div>
        <div class="off-sub">thanks for visiting. seriously.</div>
        <button type="button" class="btn-9x btn-9x--power" data-action="poweron">⏻ TURN IT BACK ON</button>
      </div>
    </div>

    <div class="screen-boot">
      <div class="boot-inner">
        <div class="boot-title">MAHANIN OS 94</div>
        <div id="boot-lines"></div>
        <div class="boot-skip">press anything to skip<span class="blink-cursor">▌</span></div>
      </div>
    </div>
  </main>
</Base>

<style is:global>
  @font-face {
    font-family: 'Silkscreen';
    src: url('/fonts/silkscreen-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/ibm-plex-mono-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/ibm-plex-mono-600.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #0e5750; }
  a { color: #8a3b12; text-decoration: underline; text-underline-offset: 2px; }
  a:hover { color: #c2477d; }

  @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes marq { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  @keyframes eq { 0%, 100% { height: 20%; } 50% { height: 100%; } }
  .blink-cursor { animation: blink 1.1s steps(1) infinite; }

  /* ---------- root / wallpaper / desktop ---------- */
  .os-root {
    position: fixed;
    inset: 0;
    background: #0e5750;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    overflow: hidden;
  }
  .wallpaper { position: absolute; inset: 0; }
  .wallpaper[data-wall="0"] { background: #0e5750; background-image: radial-gradient(rgba(255,255,255,.055) 1px,transparent 1px); background-size: 4px 4px; }
  .wallpaper[data-wall="1"] { background: #2b2450; background-image: linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px); background-size: 26px 26px; }
  .wallpaper[data-wall="2"] { background: #7a3a2e; background-image: repeating-linear-gradient(180deg,rgba(255,220,150,.13) 0 12px,transparent 12px 40px); }
  .wallpaper[data-wall="3"] { background: #7c8f4a; background-image: repeating-linear-gradient(90deg,rgba(0,0,0,.08) 0 3px,transparent 3px 6px); }

  .desktop { position: absolute; top: 0; left: 0; right: 0; bottom: 44px; overflow: hidden; }

  /* ---------- icons ---------- */
  .icons { display: grid; position: absolute; top: 18px; left: 18px; grid-template-columns: repeat(2,88px); gap: 4px 6px; z-index: 2; }
  .icons.one-col { grid-template-columns: repeat(1,88px); }
  .icon {
    display: flex; flex-direction: column; align-items: center; gap: 5px;
    padding: 8px 4px 6px; cursor: pointer; border: 1px dotted transparent; border-radius: 2px;
    background: transparent; font: inherit; color: inherit;
  }
  .icon:hover { background: rgba(255,255,255,.14); border: 1px dotted rgba(255,255,255,.55); }
  .icon-glyph { font-size: 29px; line-height: 1; filter: drop-shadow(2px 2px 0 rgba(0,0,0,.35)); }
  .icon-label { font: 400 9.5px/1.35 Silkscreen,monospace; color: #fff; text-align: center; text-shadow: 1px 1px 0 rgba(0,0,0,.5); }

  /* ---------- mobile menu ---------- */
  .mobile-menu { display: none; position: absolute; inset: 0; overflow: auto; background: rgba(6,30,28,.55); z-index: 2; }
