---
import Base from '../layouts/Base.astro';
import Window from '../components/os94/Window.astro';
import StickyNote from '../components/os94/StickyNote.astro';
import AppIcon from '../components/os94/AppIcon.astro';
import StartItem from '../components/os94/StartItem.astro';
import SysMon from '../components/os94/SysMon.astro';
import NetGauge from '../components/os94/NetGauge.astro';
import GhostIcon from '../components/os94/GhostIcon.astro';
import DeskPhoto from '../components/os94/DeskPhoto.astro';
import NetworkIcon from '../components/os94/NetworkIcon.astro';
import BrandIcon from '../components/os94/BrandIcon.astro';
import { DEFS, Z, APPS, appsById, START_ORDER } from '../data/os94.js';

const title = 'Sirawit Mahanin';
const description = "Sirawit Mahanin — Consultant Developer at Thoughtworks, Bangkok. Resume, photography, and projects.";
const canonical = 'https://mahanin.com/';
const ogTitle = 'Sirawit Mahanin';
const ogDescription = 'Consultant Developer at Thoughtworks, Bangkok. Resume, photography, and projects.';

// UPTIME is filled in by tick() in os94.js; the id is the contract, the — is the no-JS state.
const SYSMON_ROWS = [
  { label: 'HOST', value: 'SIRAWIT MAHANIN' },
  { label: 'LOC', value: 'BANGKOK, TH 🇹🇭' },
  { label: 'BUILD', value: '1994' },
  { label: 'UPTIME', id: 'uptime' },
];
---
<Base title={title} description={description} canonical={canonical} ogTitle={ogTitle} ogDescription={ogDescription}>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/silkscreen-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin>
  </Fragment>

  <main id="os" class="os-root is-booting">
    <noscript><style>.screen-boot{display:none!important}</style></noscript>

    <div id="wallpaper" class="wallpaper"></div>

    <div id="desktop" class="desktop">
      <div id="icons" class="icons">
        {APPS.map((app) => <AppIcon app={app} />)}
      </div>

      <div class="desktop-readme">
        <h1 class="readme-title">HELLO, VISITOR</h1>
        <div class="readme-subtitle">SIRAWIT &ldquo;WIT&rdquo; MAHANIN · EST. 1994</div>
        <p>Consultant Developer at Thoughtworks, Bangkok. Ex&#8209;civil engineer: I used to design things that must not fall down, now I ship things that occasionally do.</p>
        <p>I take pictures and read books. I&rsquo;ve loved computers since my parents brought one home when I was nine.</p>
        <p>I played games on it, made friends on it, and looked at a few things I probably shouldn&rsquo;t have. I was completely hooked, so my dad started hiding the keyboard. Then the mouse. Then the cable. Then the Wi&#8209;Fi adapter, in the closet, which I found every single time. That&rsquo;s how I learned to drive Windows with whatever was left.</p>
        <p>Why mahanin.com? I wanted sirawit.com, but it was taken. It worked out &mdash; it means I get to write sirawit@mahanin.com.</p>
        <noscript><p class="noscript-links"><a href="/resume/" target="_blank" rel="noopener noreferrer">Resume</a> · <a href="https://unsplash.com/@souperwit" target="_blank" rel="noopener noreferrer">Unsplash</a> · <a href="https://github.com/manooi" target="_blank" rel="noopener noreferrer">GitHub</a> · <a href="https://www.goodreads.com/review/list/177765370?shelf=read" target="_blank" rel="noopener noreferrer">Goodreads</a> · <a href="mailto:sirawit@mahanin.com">Email</a> · <a href="https://www.linkedin.com/in/sirawit-wit-mahanin-b3a42614a/" target="_blank" rel="noopener noreferrer">LinkedIn</a></p></noscript>
      </div>

      <div class="widgets">
        <DeskPhoto src="/assets/profile-note.webp" alt="Sirawit Mahanin" width={240} height={304} w={132} top={18} right={20} rotate={-2.5} />

        <GhostIcon glyph="🐸" label="camflock" top={218} right={48} />

        <StickyNote right={26} bottom={330} sign="— me">currently open to work &mdash; and to good book recommendations.</StickyNote>

        <SysMon rows={SYSMON_ROWS} />

        <NetGauge />
      </div>

      <Window id="welcome" title="👋 welcome.exe" x={DEFS.welcome.x} y={DEFS.welcome.y} w={DEFS.welcome.w} h={DEFS.welcome.h} z={Z.welcome} bodyClass="win-body--pad-lg">
        <div class="sec-label">FIRST TIME HERE?</div>
        <p>Quick menu.</p>
        <a href="/resume/" target="_blank" rel="noopener noreferrer" class="row welcome-primary">👔 <span class="row-label">open the resume</span><span class="row-badge">FOR HR &mdash; PRINTABLE PDF</span></a>
        <div class="contact-rows">
          <button type="button" class="row" data-action="min">📝 <span class="row-label">who is this guy?</span></button>
          <a href="https://unsplash.com/@souperwit" target="_blank" rel="noopener noreferrer" class="row">📷 <span class="row-label">photos</span></a>
          <button type="button" class="row" data-app="contact">✉️ <span class="row-label">say hi</span></button>
        </div>
      </Window>

      <Window id="char" title="🍁 character.dat" x={DEFS.char.x} y={DEFS.char.y} w={DEFS.char.w} h={DEFS.char.h} z={Z.char} variant="char">
        <div class="char-top">
          <div class="char-sprite">character<br>sprite</div>
          <div class="char-info">
            <div class="char-ign">[ IGN HERE ]</div>
            <div class="char-meta">LV. 32 · [ CLASS ] · [ WORLD ]</div>
            <div class="char-exp-label">EXP TO NEXT BIRTHDAY</div>
            <div class="char-exp-track"><div class="char-exp-fill"></div></div>
            <div class="char-exp-pct">62.00%</div>
          </div>
        </div>
        <div class="char-stats">
          <div class="card stat-box">HP <span class="char-stat-hp">2,140 / 2,140</span></div>
          <div class="card stat-box">MP <span class="char-stat-mp">980 / 3,000</span></div>
          <div class="card stat-box">STR <span class="char-stat-muted">deadlines</span></div>
          <div class="card stat-box">DEX <span class="char-stat-muted">camera</span></div>
          <div class="card stat-box">INT <span class="char-stat-muted">books</span></div>
          <div class="card stat-box">LUK <span class="char-stat-muted">unverified</span></div>
        </div>
        <div class="card char-equip">
          <div class="char-equip-label">EQUIPPED</div>
          keyboard · one prime lens · library card · a mug that says nothing funny
        </div>
        <p class="char-note">Tell me your real IGN, class and world and I&rsquo;ll put them in.</p>
      </Window>

      <Window id="projects" title="🛠️ projects" x={DEFS.projects.x} y={DEFS.projects.y} w={DEFS.projects.w} h={DEFS.projects.h} z={Z.projects}>
        <p>Half of these are finished. The other half taught me something, which is basically the same thing.</p>
        <div class="project-list">
          <div class="project-row"><span class="project-num">01</span><span class="project-desc">this website &mdash; <span class="project-desc-sub">a desktop that lives in a browser</span></span></div>
          <div class="project-row"><span class="project-num">02</span><span class="project-desc">[ project name ] &mdash; <span class="project-desc-sub">one line about it</span></span></div>
          <div class="project-row"><span class="project-num">03</span><span class="project-desc">[ project name ] &mdash; <span class="project-desc-sub">one line about it</span></span></div>
        </div>
        <a href="https://github.com/manooi" target="_blank" rel="noopener noreferrer" class="btn-9x">GITHUB @manooi →</a>
      </Window>

      <Window id="contact" title="✉️ say hi" x={DEFS.contact.x} y={DEFS.contact.y} w={DEFS.contact.w} h={DEFS.contact.h} z={Z.contact}>
        <p>Work, photos, book recommendations. All welcome.</p>
        <div class="contact-rows">
          <div class="row-group">
            <a href="mailto:sirawit@mahanin.com" class="row">📧 <span class="row-label row-email">sirawit@mahanin.com</span></a>
            <button type="button" class="copy-btn" data-action="copy" data-copy-text="sirawit@mahanin.com" data-idle-label="📋" aria-label="Copy email address">📋</button>
          </div>
          <a href="https://www.linkedin.com/in/sirawit-wit-mahanin-b3a42614a/" target="_blank" rel="noopener noreferrer" class="row"><BrandIcon name="linkedin" /><span class="row-label">LinkedIn</span></a>
          <a href="https://github.com/manooi" target="_blank" rel="noopener noreferrer" class="row"><BrandIcon name="github" /><span class="row-label">GitHub</span></a>
        </div>
      </Window>

      <!-- Every row's punchline lives in its own data-note, so all the copy stays here
           in the markup and os94.js only has to move a string into #bin-status. -->
      <Window id="recycle" title="🗑️ recycle bin" x={DEFS.recycle.x} y={DEFS.recycle.y} w={DEFS.recycle.w} h={DEFS.recycle.h} z={Z.recycle} bodyClass="win-body--flush-x">
        <div class="bin-list">
          <button type="button" class="bin-item" data-action="bin" data-note="Three files. All of them are photographs of my cat. You looked, though. That's the part worth sitting with."><span class="bin-icon">📁</span><span class="bin-name">xxx</span><span class="bin-meta">3 items</span></button>
          <button type="button" class="bin-item" data-action="bin" data-note="Empty. I moved everything to a password manager like an adult."><span class="bin-icon">📄</span><span class="bin-name">passwords.txt</span><span class="bin-meta">0 KB</span></button>
          <button type="button" class="bin-item" data-action="bin" data-note="The largest folder on this machine by a comfortable margin. Restoring it is how the good ideas got made."><span class="bin-icon">📁</span><span class="bin-name">ideas_that_didnt_work</span><span class="bin-meta">214 items</span></button>
          <button type="button" class="bin-item" data-action="bin" data-note="Deleted 2021. Load-bearing walls, cost sheets, a hard hat. I loved computers from the first one I ever played on — I still have no idea how I ended up a civil engineer."><span class="bin-icon">📐</span><span class="bin-name">civil_engineering_career.dwg</span><span class="bin-meta">12.4 MB</span></button>
        </div>
        <div class="bin-bar">
          <button type="button" class="btn-9x btn-9x--sm" data-action="bin" data-note="Emptied. They came back.">EMPTY RECYCLE BIN</button>
          <span class="bin-count">4 items</span>
        </div>
        <div class="bin-status" id="bin-status">Click a file. Nothing in here is recoverable, emotionally or otherwise.</div>
      </Window>

      <Window id="taskman" title="⚙️ taskman.exe" x={DEFS.taskman.x} y={DEFS.taskman.y} w={DEFS.taskman.w} h={DEFS.taskman.h} z={Z.taskman}>
        <div class="sec-label">TASK MANAGER</div>
        <p>You right&#8209;clicked the taskbar. Genuine respect for that.</p>
        <p>But be honest &mdash; did you really expect me to build a working task manager? The illusion goes exactly this deep.</p>
        <button type="button" class="btn-9x" data-action="close">FAIR ENOUGH</button>
      </Window>

      <Window id="netmon" title="📶 cfosspeed.exe" x={DEFS.netmon.x} y={DEFS.netmon.y} w={DEFS.netmon.w} h={DEFS.netmon.h} z={Z.netmon}>
        <div class="sec-label">TRAFFIC MONITOR</div>
        <p>You knew this program.</p>
        <p>I installed cFosSpeed on every computer I owned, certain that watching the traffic would make it faster. It never did. I kept it running anyway.</p>
        <button type="button" class="btn-9x" data-action="close">STILL FASTER</button>
      </Window>

      <Window id="winamp" title="🎵 winamp" x={DEFS.winamp.x} y={DEFS.winamp.y} w={DEFS.winamp.w} h={DEFS.winamp.h} z={Z.winamp} bodyClass="win-body--flush">
        <div class="winamp-head">
          <span class="winamp-head-label">NOW PLAYING</span>
          <span class="winamp-head-kbps">KBPS 128</span>
        </div>
        <div class="winamp-body">
          <div class="winamp-track"><span class="winamp-track-text">[ your track here ] — [ artist ] &nbsp;·&nbsp; [ something on repeat ] &nbsp;·&nbsp; [ your track here ] — [ artist ] &nbsp;·&nbsp; [ something on repeat ] &nbsp;·&nbsp; </span></div>
          <div class="winamp-eq">
            <span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span>
          </div>
          <div class="winamp-transport">
            <span class="winamp-btn">◀◀</span>
            <span class="winamp-btn winamp-btn--accent">▶</span>
            <span class="winamp-btn">❚❚</span>
            <span class="winamp-btn">▶▶</span>
          </div>
        </div>
      </Window>
    </div>

    <div id="start-menu" class="start-menu" data-menu="start">
      <div class="start-spine"><span class="start-spine-label">MAHANIN 94</span></div>
      <div class="start-items">
        {START_ORDER.map((id) => (
          id === null ? <div class="menu-sep"></div> : <StartItem app={appsById[id]} />
        ))}
        <button type="button" class="start-item start-item--danger" data-action="shutdown"><span class="start-item-icon">⏻</span>shut down...</button>
      </div>
    </div>

    <!-- Right-click menus, positioned at the cursor by JS. data-menu keeps the
         outside-click handler from closing them on their own mousedown. The taskbar
         one is the only opener taskman.exe has. -->
    <div id="desktop-menu" class="ctx-menu" data-menu="desktop">
      <button type="button" class="menu-item" data-action="refresh">Refresh</button>
    </div>

    <div id="taskbar-menu" class="ctx-menu" data-menu="taskbar">
      <button type="button" class="menu-item" data-app="taskman">Task Manager</button>
    </div>

    <div class="taskbar">
      <button type="button" class="start-btn" data-action="start" data-menu="start">
        <span class="start-btn-logo"></span>
        <span class="start-btn-label">MAHANIN</span>
      </button>
      <div class="tb-sep"></div>
      <!-- Empty on load and that is correct: no window ships is-open, so renderTaskbar()
           derives an empty list. Server-rendered buttons here must always match. -->
      <div id="taskbar-btns" class="taskbar-btns"></div>
      <div class="tray">
        <NetworkIcon />
        <span class="tray-divider"></span>
        <span id="clock">--:-- --</span>
      </div>
    </div>

    <div class="screen-off">
      <div class="off-inner">
        <div class="off-title">IT&rsquo;S NOW SAFE TO CLOSE<br>THIS TAB.</div>
        <div class="off-sub">thanks for visiting. seriously.</div>
        <button type="button" class="btn-9x btn-9x--power" data-action="poweron">⏻ TURN IT BACK ON</button>
      </div>
    </div>

    <div class="screen-boot">
      <div class="boot-inner">
        <div class="boot-title">MAHANIN OS 94</div>
        <div id="boot-lines"></div>
        <div class="boot-skip">press anything to skip<span class="blink-cursor">▌</span></div>
      </div>
    </div>

    <script src="../scripts/os94.js"></script>
  </main>
</Base>

<style is:global>
  @font-face {
    font-family: 'Silkscreen';
    src: url('/fonts/silkscreen-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/ibm-plex-mono-400.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/ibm-plex-mono-600.woff2') format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #0e5750; touch-action: manipulation; }
  a { color: #8a3b12; text-decoration: underline; text-underline-offset: 2px; }
  a:hover { color: #c2477d; }

  @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes marq { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  @keyframes eq { 0%, 100% { height: 20%; } 50% { height: 100%; } }
  @keyframes doodle-nudge { 0%, 100% { transform: translate(0,0); } 50% { transform: translate(4px,3px); } }
  /* steps() keeps the desktop Refresh blink chunky rather than a smooth fade. */
  @keyframes icons-repaint { from { opacity: 0; } to { opacity: 1; } }
  @keyframes net-blink { 0%, 18% { opacity: .3; } 19%, 100% { opacity: 1; } }
  .blink-cursor { animation: blink 1.1s steps(1) infinite; }

  /* ---------- root / wallpaper / desktop ---------- */
  .os-root {
    position: fixed;
    inset: 0;
    background: #0e5750;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    overflow: hidden;
  }
  .wallpaper { position: absolute; inset: 0; background: #0e5750; background-image: radial-gradient(rgba(255,255,255,.055) 1px,transparent 1px); background-size: 4px 4px; }

  .desktop { position: absolute; top: 0; left: 0; right: 0; bottom: 44px; overflow: hidden; }

  /* ---------- icons ---------- */
  .icons { display: grid; position: absolute; top: 18px; left: 18px; grid-template-columns: repeat(1,88px); gap: 4px 6px; z-index: 2; }
  .icons.is-refreshing { animation: icons-repaint .22s steps(3); }
  .icon {
    position: relative;
    display: flex; flex-direction: column; align-items: center; gap: 5px;
    padding: 8px 4px 6px; cursor: pointer; border: 1px dotted transparent; border-radius: 2px;
    background: transparent; font: inherit; color: inherit; text-decoration: none;
    touch-action: manipulation;
  }
  .icon:hover { background: rgba(255,255,255,.14); border: 1px dotted rgba(255,255,255,.55); }
  .icon-glyph { font-size: 29px; line-height: 1; filter: drop-shadow(2px 2px 0 rgba(0,0,0,.35)); }
  .icon-label { font: 400 9.5px/1.35 Silkscreen,monospace; color: #fff; text-align: center; text-shadow: 1px 1px 0 rgba(0,0,0,.5); }

  /* Doodle is anchored to its icon (position: relative above), never to grid maths —
     icon heights differ by label line count, so absolute coordinates would drift. */
  .icon-doodle {
    position: absolute; left: calc(100% - 8px); top: 26px;
    display: flex; flex-direction: column; align-items: flex-start; gap: 3px;
    color: #f2c14b; pointer-events: none;
  }
  .icon-doodle-arrow { width: 48px; height: 23px; flex: none; filter: drop-shadow(1px 1px 0 rgba(0,0,0,.4)); }
  .icon-doodle-text {
    margin-left: 6px; font: 400 11px/1.2 Silkscreen,monospace; white-space: nowrap;
    transform: rotate(-5deg); text-shadow: 1px 1px 0 rgba(0,0,0,.45);
  }
  @media (prefers-reduced-motion: no-preference) {
    .icon-doodle { animation: doodle-nudge 2.6s ease-in-out infinite; }
  }

  /* ---------- readme-on-desktop ----------
     Single source in the DOM for both breakpoints (see mobile section below):
     desktop centers it absolutely between the icon column and the widgets;
     mobile lets it flow in normal document order below the app menu instead. */
  .desktop-readme {
    position: absolute; z-index: 1;
    top: 50%; left: 140px; right: 250px; transform: translateY(-50%);
    width: 480px; max-width: 100%; margin: 0 auto;
  }
  .desktop-readme p { font: 400 12.5px/1.7 'IBM Plex Mono',monospace; color: #dff5f0; margin: 0 0 10px; }

  /* ---------- desktop widgets ---------- */
  .widgets { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  /* Geometry arrives as custom properties from <StickyNote> — see the component for the
     prop list. pointer-events: auto is the opt-in out of the .widgets overlay (invariant 8);
     every note needs it, so it lives on the base class rather than per-note. */
  .sticky-note {
    position: absolute;
    top: var(--top, auto); right: var(--right, auto); bottom: var(--bottom, auto); left: var(--left, auto);
    width: var(--w, 180px); padding: 13px 14px 15px;
    background: #f2e27a; box-shadow: 3px 3px 0 rgba(0,0,0,.28); transform: rotate(var(--rot, -2.2deg));
    font: 400 12px/1.55 'IBM Plex Mono',monospace; color: #4a3d05; pointer-events: auto;
  }
  /* Same shape as a real .icon so it reads as a shortcut, then faded down to a ghost.
     No :hover, no cursor, no pointer-events opt-in — it is scenery, not an app. */
  .ghost-icon {
    position: absolute;
    top: var(--top, auto); right: var(--right, auto); bottom: var(--bottom, auto); left: var(--left, auto);
    display: flex; flex-direction: column; align-items: center; gap: 5px;
    width: 76px; padding: 8px 4px 6px; opacity: .3;
  }
  .ghost-icon-glyph { font-size: 29px; line-height: 1; filter: grayscale(.45) drop-shadow(2px 2px 0 rgba(0,0,0,.35)); }
  .ghost-icon-label { font: 400 9.5px/1.35 Silkscreen,monospace; color: #fff; text-align: center; text-shadow: 1px 1px 0 rgba(0,0,0,.5); }

  .sticky-note-label { font: 400 10px/1.4 Silkscreen,monospace; color: #8a6f0e; margin-bottom: 7px; }
  .sticky-note-sign { margin-top: 8px; font-size: 10.5px; color: #8a6f0e; }
  /* The one thing on the desktop you can pick up. Anchored by whichever sides the call
     site passes until the first drag, then os94.js writes --x/--y and .is-dragged flips it
     to left/top — a right-anchored element cannot take a cursor delta. touch-action: none
     keeps a touch-drag from scrolling the page instead of moving the photo. */
  .desk-photo {
    position: absolute;
    top: var(--top, auto); right: var(--right, auto); bottom: var(--bottom, auto); left: var(--left, auto);
    width: var(--w, 132px); padding: 5px; background: #fffdf7;
    box-shadow: 3px 3px 0 rgba(0,0,0,.3); transform: rotate(var(--rot, -2.5deg));
    pointer-events: auto; cursor: grab; touch-action: none; user-select: none;
  }
  .desk-photo.is-dragged { top: var(--y); left: var(--x); right: auto; bottom: auto; }
  .desk-photo:active { cursor: grabbing; }
  .desk-photo img { display: block; width: 100%; height: auto; }

  .sticky-note--mint { background: #a8e6cf; color: #123f36; }
  .sticky-note--mint .sticky-note-label, .sticky-note--mint .sticky-note-sign { color: #2f7a68; }
  .sticky-note--pink { background: #f5b7d0; color: #4a1330; }
  .sticky-note--pink .sticky-note-label, .sticky-note--pink .sticky-note-sign { color: #a03a6b; }

  .winamp-head { display: flex; align-items: center; gap: 6px; padding: 4px 6px; background: linear-gradient(90deg,#14101f,#3a3450); }
  .winamp-head-label { font: 400 8.5px Silkscreen,monospace; color: #8fe3d6; flex: 1; }
  .winamp-head-kbps { font: 400 8.5px Silkscreen,monospace; color: #f2c14b; }
  .winamp-body { padding: 9px 10px 11px; }
  .winamp-track { background: #14101f; border: 1px solid #6b619b; padding: 5px 6px; overflow: hidden; white-space: nowrap; }
  .winamp-track-text { display: inline-block; font: 400 9.5px Silkscreen,monospace; color: #8fe3d6; animation: marq 11s linear infinite; }
  .winamp-eq { display: flex; align-items: flex-end; gap: 2px; height: 22px; margin: 8px 0 7px; }
  .eq-bar { flex: 1; background: #8fe3d6; }
  .eq-bar:nth-child(1) { animation: eq .9s ease-in-out infinite; height: 40%; }
