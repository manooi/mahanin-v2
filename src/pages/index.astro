---
import Base from '../layouts/Base.astro';

const title = 'Sirawit Mahanin';
const description = "Sirawit Mahanin — Consultant Developer at Thoughtworks, Bangkok. Resume, photography, and projects.";
const canonical = 'https://mahanin.com/';
const ogTitle = 'Sirawit Mahanin';
const ogDescription = 'Consultant Developer at Thoughtworks, Bangkok. Resume, photography, and projects.';
---
<Base title={title} description={description} canonical={canonical} ogTitle={ogTitle} ogDescription={ogDescription}>
  <main>
    <section id="intro">
      <h1>Sirawit Mahanin</h1>
      <p class="tagline">🇹🇭 Consultant Developer at Thoughtworks, Bangkok. Ex-civil engineer.
        I build things and take pictures.</p>
    </section>

    <hr>

    <section id="links">
      <ul class="hub-list">
        <li>
          <a href="/resume/">📄 Resume</a>
          <p>Who I am, what I've shipped, where I'm heading. Printable to PDF.</p>
        </li>
        <li>
          <a href="https://unsplash.com/@manooi">📷 Photography</a>
          <p>My pictures on Unsplash.</p>
        </li>
        <li>
          <a href="https://github.com/manooi">🛠️ Projects</a>
          <p>Code and experiments on GitHub.</p>
        </li>
      </ul>
    </section>

    <hr>

    <section id="contact">
      <p class="contact">
        📧 <a href="mailto:sirawit@mahanin.com">sirawit@mahanin.com</a> · <a href="https://www.linkedin.com/in/sirawit-wit-mahanin-b3a42614a/">LinkedIn</a>
      </p>
    </section>
  </main>
</Base>

<style is:global>
  body {
    font-family: ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
    line-height: 1.5;
    color: #111;
  }

  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  h1 {
    font-size: 1.875rem;
    font-weight: 700;
    margin: 0;
  }

  .tagline {
    margin: 0.5rem 0 0;
    font-size: 1.125rem;
  }

  hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 2rem 0;
  }

  .hub-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hub-list li + li {
    margin-top: 1.5rem;
  }

  .hub-list a {
    color: #111;
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: underline;
  }

  .hub-list p {
    margin: 0.25rem 0 0;
    color: #4b5563;
  }

  .contact {
    font-size: 0.875rem;
    color: #4b5563;
  }

  .contact a {
    color: inherit;
    text-decoration: underline;
  }
</style>
