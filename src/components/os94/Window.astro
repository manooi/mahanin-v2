---
interface Props {
  id: string;
  title: string;
  x: number;
  y: number;
  w: number;
  h: number;
  z: number;
  variant?: 'char' | 'term';
  open?: boolean;
  bodyClass?: string;
}

const { id, title, x, y, w, h, z, variant, open = false, bodyClass = '' } = Astro.props;

const winClass = ['win', open ? 'is-open' : ''].filter(Boolean).join(' ');
const titleClass = ['win-title', variant === 'char' ? 'win-title--char' : ''].filter(Boolean).join(' ');
const bodyClasses = ['win-body', variant ? `win-body--${variant}` : '', bodyClass].filter(Boolean).join(' ');
---
<section class={winClass} id={`win-${id}`} data-win={id} data-label={title} style={`--x:${x}px;--y:${y}px;--w:${w}px;--h:${h}px;--z:${z}`}>
  <div class="win-frame">
    <div class={titleClass} data-drag>
      <span class="win-title-label">{title}</span>
      <button type="button" class="win-btn win-btn--min" data-action="min" aria-label={`Minimize ${title}`}>_</button>
      <button type="button" class="win-btn win-btn--close" data-action="close" aria-label={`Close ${title}`}>✕</button>
    </div>
    <div class={bodyClasses}><slot /></div>
  </div>
</section>
